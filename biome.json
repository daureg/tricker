{
  "vcs": {
    "clientKind": "git",
    "enabled": true
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "linter": {
    "rules": {
      "suspicious": {
        "useIterableCallbackReturn": {
          "options": {
            "checkForEach": false
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "src/travel_blog/resources/*.js",
      "src/travel_blog/resources/*.html",
      "biome.json"
    ]
  }
}
